{
  "uid": "n8n-workflow-executions-api",
  "title": "n8n Workflow Executions (API)",
  "description": "Workflow and execution observability for n8n Cloud and self-hosted n8n via the n8n public API.",
  "tags": ["n8n", "api"],
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "n8n",
        "type": "datasource",
        "query": "nluecke-n8n-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "workflow",
        "label": "Workflow",
        "type": "query",
        "datasource": {
          "type": "nluecke-n8n-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "refId": "workflow",
          "resource": "workflows"
        },
        "definition": "workflows",
        "multi": true,
        "includeAll": true,
        "allValue": "$__all",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Executive summary",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Executions",
      "description": "Executions started in the time range (from the execution list).",
      "datasource": {
        "type": "nluecke-n8n-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "nluecke-n8n-datasource",
            "uid": "${datasource}"
          },
          "workflowIds": ["$workflow"],
          "metric": "count",
          "queryType": "executionStats",
          "bucket": "range",
          "groupBy": "none"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Success rate",
      "description": "success / (success + error + crashed). Running and canceled executions are not counted.",
      "datasource": {
        "type": "nluecke-n8n-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 1
      },
