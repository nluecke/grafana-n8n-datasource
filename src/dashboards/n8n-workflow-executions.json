      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "nluecke-n8n-datasource",
            "uid": "${datasource}"
          },
          "workflowIds": ["$workflow"],
          "queryType": "executionStats",
          "metric": "count",
          "groupBy": "status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
