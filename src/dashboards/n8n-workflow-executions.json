          "queryType": "executions",
          "statuses": ["error", "crashed"]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "workflowId": true,
              "url": true,
              "mode": true
            }
          }
