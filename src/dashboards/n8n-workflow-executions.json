    {
      "type": "table",
      "id": 12,
      "title": "Top failing workflows",
      "description": "",
      "datasource": {
        "type": "nluecke-n8n-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "nluecke-n8n-datasource",
            "uid": "${datasource}"
          },
          "workflowIds": ["$workflow"],
          "queryType": "executionStats",
          "metric": "count",
          "groupBy": "workflow",
          "statuses": ["error", "crashed"],
          "bucket": "range"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["lastNotNull"],
            "mode": "seriesToRows",
            "includeTimeField": false
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "Last *",
                "config": {
                  "id": "lowerOrEqual",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Last *",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 10
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Field": "Workflow",
              "Last *": "Failed executions"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed executions"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
