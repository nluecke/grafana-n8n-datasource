      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "error": {
                        "color": "red",
                        "index": 1
                      },
                      "crashed": {
                        "color": "dark-red",
                        "index": 2
                      },
                      "canceled": {
                        "color": "gray",
                        "index": 3
                      },
                      "running": {
                        "color": "blue",
                        "index": 4
                      },
                      "waiting": {
                        "color": "yellow",
                        "index": 5
                      },
                      "new": {
                        "color": "purple",
                        "index": 6
                      },
                      "unknown": {
                        "color": "text",
                        "index": 7
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
