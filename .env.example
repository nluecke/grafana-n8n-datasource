# Local n8n (docker-compose.yaml). `make dev` creates the owner and both keys on a fresh instance.
N8N_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_SEED_API_KEY=
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_PASSWORD="DevPassw0rd!"

# Optional second instance for the "n8n remote" datasource (n8n Cloud or another self-hosted n8n)
N8N_CLOUD_URL="https://<instance>.app.n8n.cloud/api/v1"
N8N_CLOUD_API_KEY=


# Host port for Grafana (default 3000)
GRAFANA_PORT=3000
